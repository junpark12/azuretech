# Source-derived template. Replace every YOUR_* value before manual use.
# Set APIM_SUBSCRIPTION_KEY in the VS Code extension host environment.
# Use an APIM subscription key, not a Foundry API key. Never save keys here.
@apimBaseUrl = https://YOUR_APIM_HOST

### v1 Chat: one non-streaming request
# The model field selects the deployment; no api-version query is required.
# A 429 can trigger one additional APIM attempt.
# @name v1ChatCompletions
POST {{apimBaseUrl}}/openai/v1/chat/completions
Content-Type: application/json
Accept: application/json
Ocp-Apim-Subscription-Key: {{$processEnv APIM_SUBSCRIPTION_KEY}}

{
  "model": "YOUR_DEPLOYMENT_NAME",
  "messages": [{"role": "user", "content": "Reply with OK only."}],
  "max_completion_tokens": 128,
  "reasoning_effort": "none",
  "stream": false,
  "store": false
}
